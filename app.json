    "android": {
      "package": "com.yourcompany.nusuniwash",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "02d67ada-5d1e-42c2-9424-9732978fe9b2"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/02d67ada-5d1e-42c2-9424-9732978fe9b2"
    }
  }
}
